# scripts/deploy-oci.sh copia este arquivo para .env quando ele não existe
# na VM (cp .env.example .env) e para nesse ponto, para que os valores
# sejam revisados antes do deploy prosseguir.
#
# Nota (ver ADR-004): docker-compose.yml hoje NÃO lê essas variáveis — os
# valores de banco e URL do ds-service estão hardcoded diretamente no
# compose (incluindo a senha, que é a mesma usada como placeholder abaixo
# antes desta revisão). Este arquivo documenta o formato esperado e evita
# que o script de deploy falhe em clone limpo; os valores de senha são
# placeholders a preencher, não segredo real — não altera o comportamento
# do compose até que ele seja parametrizado para consumir estas variáveis.

# PostgreSQL
POSTGRES_DB=sentimentdb
POSTGRES_USER=sentiment_user
POSTGRES_PASSWORD=CHANGE_ME

# Backend Spring Boot
SPRING_PROFILES_ACTIVE=prod
DS_SERVICE_URL=http://ds-service:8000
DATABASE_URL=jdbc:postgresql://postgres:5432/sentimentdb
DATABASE_USER=sentiment_user
DATABASE_PASSWORD=CHANGE_ME
